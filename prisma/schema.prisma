generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev machines; debian-openssl-3.0.x covers the
  // node:20-slim Docker runtime (Alpine/musl OpenSSL-3.0 auto-detection is
  // unreliable on current Alpine releases, so we deploy on Debian instead).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Canonical schema for Speaking Core 1350.
// Mirrors database/schema.prisma (the reviewed initial contract) 1:1; this
// copy is what Prisma CLI and the API actually run against.

model User {
  id                 String               @id @default(uuid())
  googleId           String               @unique
  email              String               @unique
  displayName        String?
  profileImageUrl    String?
  timezone           String               @default("Asia/Seoul")
  progress           LearningProgress[]
  sessions           StudySession[]
  reviews            StudyReview[]
  chunkDrillProgress ChunkDrillProgress[]
  speakingPatternProgress SpeakingPatternProgress[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  lastLoginAt        DateTime?
}

model LearningItem {
  id             Int                @id
  category       String
  rank           Int
  english        String
  korean         String
  example        String
  datasetVersion String             @default("2.0")
  sourceType     String             @default("curated-speaking-core")
  isActive       Boolean            @default(true)
  progress       LearningProgress[]
  reviews        StudyReview[]
  @@unique([category, rank])
  @@index([category, isActive])
}

model LearningProgress {
  id             String       @id @default(uuid())
  userId         String
  learningItemId Int
  reps           Int          @default(0)
  ease           Float        @default(2.5)
  intervalDays   Int          @default(0)
  dueDate        DateTime?
  lapses         Int          @default(0)
  lastReviewedAt DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItem   LearningItem @relation(fields: [learningItemId], references: [id], onDelete: Cascade)
  @@unique([userId, learningItemId])
  @@index([userId, dueDate])
}

model StudySession {
  id            String        @id @default(uuid())
  userId        String
  mode          String
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  reviewedCount Int           @default(0)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews       StudyReview[]
  @@index([userId, startedAt])
}

model StudyReview {
  id               String       @id @default(uuid())
  sessionId        String
  userId           String
  learningItemId   Int
  rating           Int
  previousInterval Int
  nextInterval     Int
  previousEase     Float
  nextEase         Float
  reviewedAt       DateTime     @default(now())
  session          StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItem     LearningItem @relation(fields: [learningItemId], references: [id], onDelete: Cascade)
  @@index([userId, reviewedAt])
  @@index([learningItemId])
}

// Chunk speaking drill (docs: high-frequency spoken-English chunk shadowing
// practice, separate from the SRS-scheduled LearningItem catalog above).
model ChunkItem {
  id             Int                  @id
  rank           Int                  @unique
  english        String
  korean         String
  example        String
  datasetVersion String               @default("1.0")
  isActive       Boolean              @default(true)
  progress       ChunkDrillProgress[]
}

model ChunkDrillProgress {
  id              String    @id @default(uuid())
  userId          String
  chunkItemId     Int
  practiceCount   Int       @default(0)
  lastPracticedAt DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunkItem       ChunkItem @relation(fields: [chunkItemId], references: [id], onDelete: Cascade)
  @@unique([userId, chunkItemId])
  @@index([userId, practiceCount])
}

// Speaking Pattern Core: reusable sentence-frame ("It was difficult to ___")
// learning, distinct from the item-level LearningItem/ChunkItem catalogs
// above -- a SpeakingPattern is a frame with slots, examples, an optional
// multi-level expansion ladder, and related/contrast pattern links. slots/
// examples/expansions are stored as Json (always read whole, never queried
// by sub-field) rather than join tables, matching this schema's existing
// preference for simplicity over enterprise abstraction. parentPatternId is
// a soft self-reference by id (not a Prisma @relation) to a family's root
// pattern, used for grouping only -- deleting a parent never cascades to
// children through it.
model SpeakingPattern {
  id                  String                    @id
  rank                Int                       @unique
  speakingIntent      String
  familyId            String
  familyLabel         String
  parentPatternId     String?
  pattern             String
  koreanMeaning       String
  speakingFunction    String
  description         String?
  slots               Json
  examples            Json
  expansions          Json?
  relatedPatternIds   String[]                  @default([])
  contrastPatternIds  String[]                  @default([])
  tags                String[]                  @default([])
  difficulty          Int                       @default(1)
  priority            Int                       @default(0)
  datasetVersion      String                    @default("1.0")
  isActive            Boolean                   @default(true)
  progress            SpeakingPatternProgress[]
  @@index([speakingIntent, isActive])
  @@index([familyId])
}

model SpeakingPatternProgress {
  id              String          @id @default(uuid())
  userId          String
  patternId       String
  practiceCount   Int             @default(0)
  favorite        Boolean         @default(false)
  lastPracticedAt DateTime?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern         SpeakingPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  @@unique([userId, patternId])
  @@index([userId, practiceCount])
}
