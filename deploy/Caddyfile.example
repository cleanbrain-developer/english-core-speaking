# Real domain, served on a custom external port (:3000) with automatic
# HTTPS. Caddy still needs host port 80 reachable (see
# docker-compose.prod.yml) to complete the Let's Encrypt HTTP-01 challenge
# and its renewals, even though nothing is actually served on 80 itself —
# Caddy also uses it to redirect stray http:// hits to the https://:3000 site.
cleanbrain.me:3000 {
  encode zstd gzip
  handle /api/* {
    reverse_proxy api:3000
  }
  handle {
    reverse_proxy web:80
  }
}

# No domain yet? Use a bare port instead (plain HTTP, no TLS/ACME at all).
# Also change docker-compose.prod.yml's caddy ports to just "3000:80".
# :80 {
#   encode zstd gzip
#   handle /api/* {
#     reverse_proxy api:3000
#   }
#   handle {
#     reverse_proxy web:80
#   }
# }

# Prefer the standard HTTPS port instead of a custom one? Drop ":3000" from
# the site address below (Caddy defaults to 443), and change
# docker-compose.prod.yml's caddy ports to "80:80" / "443:443".
# cleanbrain.me {
#   encode zstd gzip
#   handle /api/* {
#     reverse_proxy api:3000
#   }
#   handle {
#     reverse_proxy web:80
#   }
# }
