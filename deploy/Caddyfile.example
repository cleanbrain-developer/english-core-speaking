# Real domain, plain HTTP, custom port — no TLS/ACME involved at all. The
# explicit "http://" scheme tells Caddy not to attempt automatic HTTPS for
# this site, so host port 80 doesn't need to be open for this to work.
http://cleanbrain.me:3000 {
  encode zstd gzip
  handle /api/* {
    reverse_proxy api:3000
  }
  handle {
    reverse_proxy web:80
  }
}

# Ready for automatic HTTPS later? Drop the "http://" prefix and keep the
# port (Caddy issues/renews a Let's Encrypt cert via the HTTP-01 challenge,
# which needs host port 80 reachable — see docker-compose.prod.yml):
# cleanbrain.me:3000 {
#   encode zstd gzip
#   handle /api/* {
#     reverse_proxy api:3000
#   }
#   handle {
#     reverse_proxy web:80
#   }
# }

# No domain yet? Use a bare port instead:
# :3000 {
#   encode zstd gzip
#   handle /api/* {
#     reverse_proxy api:3000
#   }
#   handle {
#     reverse_proxy web:80
#   }
# }

# Prefer the standard HTTPS port instead of a custom one? Drop ":3000" and
# "http://" (Caddy defaults to 443 with automatic HTTPS), and change
# docker-compose.prod.yml's caddy ports to "80:80" / "443:443":
# cleanbrain.me {
#   encode zstd gzip
#   handle /api/* {
#     reverse_proxy api:3000
#   }
#   handle {
#     reverse_proxy web:80
#   }
# }
