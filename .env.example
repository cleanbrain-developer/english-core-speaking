# PostgreSQL
POSTGRES_DB=speaking_core
POSTGRES_USER=speaking_core
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://speaking_core:CHANGE_ME@postgres:5432/speaking_core?schema=public

# Google OAuth 2.0 / OpenID Connect (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Must exactly match an "Authorized redirect URI" on the OAuth client, e.g. https://english.example.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Application session (used to sign the HttpOnly session cookie) - generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_LONG_RANDOM

# Frontend origin allowed by CORS and used as the post-login redirect target
FRONTEND_ORIGIN=http://localhost:5173

# Frontend build-time API base path
VITE_API_BASE_URL=/api

TZ=Asia/Seoul
NODE_ENV=development
